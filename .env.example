# Firebase console -> Project settings -> General -> Your apps -> Web app config.
# These are public by design; Security Rules and App Check are what protect you.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Supabase holds the file bytes. Dashboard -> Project Settings -> API.
# The anon key is public by design; RLS policies protect the bucket.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Firebase console -> App Check -> register the web app with reCAPTCHA v3.
# Leave blank in dev; set it before you deploy.
VITE_RECAPTCHA_SITE_KEY=

# Days before a dropped file auto-deletes. Keep this in sync with the GCS
# lifecycle rule (see README) or blobs will outlive their metadata.
VITE_RETENTION_DAYS=7
